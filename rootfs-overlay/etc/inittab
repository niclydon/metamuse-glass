# busybox inittab for Glass OS (Muse Gadget Overlay)
::sysinit:/etc/glass/rcS
# Serial console shell on ttyO2 (115200n8, enabled by stock XE24 cmdline)
::respawn:/etc/glass/console uart
# USB gadget serial shell on ttyGS0 (if composite ACM is enabled)
::respawn:/etc/glass/console usb
# Stage-2 Dual-Boot Chooser + Display HUD (Vox / GlassOS or NexusOS / Prism)
::respawn:/etc/glass/hud
# SSH server (keys-only: -s -g via /etc/glass/sshd; no password or blank-password login)
::respawn:/etc/glass/sshd
::ctrlaltdel:/sbin/reboot
::shutdown:/bin/sync
