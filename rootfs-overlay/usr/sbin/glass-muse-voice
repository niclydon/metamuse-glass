#!/bin/sh
# glass-muse-voice: Realtime streaming voice-call controller for Google Glass
# Explorer Edition (Vox / muse-gadget-overlay).
#
# Uses Meta Muse SDK's `VoiceCall` (`POST /voice/realtime` over Noise with
# `app_id="hatch-web"`, `server_vad`, 24 kHz mono PCM16LE) connected directly to:
#   - `glass-wav stream-mic`: live 48 kHz -> 24 kHz PCM16LE mic stream
#   - `conversation.item.input_audio_transcription.delta/.completed` -> live HUD user text
#   - `response.output_audio_transcript.delta/.done` -> live HUD streaming reply text
#   - `glass-wav stream-play`: live 24 kHz -> 48 kHz bone-conduction playback + 24-fps Chibi lip-sync
set -eu

mkdir -p /run/glass /tmp/muse-voice /var/lib/musegadget/recordings

if [ "${1:-}" = "--tap" ]; then
    if [ -f /run/glass/voice-turn.lock ] && kill -0 "$(cat /run/glass/voice-turn.lock 2>/dev/null)" 2>/dev/null; then
        if grep -q "LISTENING" /run/glass/nova-state 2>/dev/null; then
            touch /run/glass/stop-record
            exit 0
        fi
        touch /run/glass/stop-call
        killall glass-wav 2>/dev/null || true
        echo "0" > /run/glass/nova-rms
        echo "READY (TAP TO TALK)" > /run/glass/nova-state
        exit 0
    fi
    shift
fi

rm -f /run/glass/stop-record /run/glass/stop-call
echo "$$" > /run/glass/voice-turn.lock
trap 'rm -f /run/glass/voice-turn.lock /run/glass/stop-record /run/glass/stop-call; echo "0" > /run/glass/nova-rms' EXIT INT TERM

# Ensure system clock is >= 2026 so TLS 1.3 certificate validation never fails on cold boot
if [ "$(date +%Y 2>/dev/null || echo 1970)" -lt 2026 ]; then
    hwclock -s -u 2>/dev/null || true
    if [ "$(date +%Y 2>/dev/null || echo 1970)" -lt 2026 ] && [ -s /var/lib/musegadget/last-clock ]; then
        date -u -s "$(cat /var/lib/musegadget/last-clock)" >/dev/null 2>&1 || true
    fi
    ntpd -n -q -p 162.159.200.1 -p 162.159.200.123 >/dev/null 2>&1 || true
    if [ "$(date +%Y 2>/dev/null || echo 1970)" -ge 2026 ]; then
        hwclock -w -u 2>/dev/null || true
        date -u +"%Y-%m-%d %H:%M:%S" > /var/lib/musegadget/last-clock 2>/dev/null || true
    fi
fi

/usr/sbin/glass-audio-route >/dev/null 2>&1 || true

RECORD_SECS="${RECORD_SECS:-14}"
WORK_DIR="${WORK_DIR:-/tmp/muse-voice}"
IN_WAV="$WORK_DIR/question.wav"
OUT_WAV="$WORK_DIR/reply.wav"

CUSTOM_THREAD_ID=""
if [ -f /etc/muse-gadget/voice.env ]; then
    # shellcheck disable=SC1091
    . /etc/muse-gadget/voice.env || true
    CUSTOM_THREAD_ID="${THREAD_ID:-}"
fi

echo "CONNECTING..." > /run/glass/nova-state
echo "[CONNECTING LIVE CALL...]" > /run/glass/nova-user
echo "..." > /run/glass/nova-reply

export RECORD_SECS WORK_DIR IN_WAV OUT_WAV CUSTOM_THREAD_ID

python3 - <<'PY'
import asyncio
import os
import subprocess
import sys
import time
import wave

from musegadget import __version__, config, identity, muse_api
from musegadget.link_client import DeviceDescription, LinkSession
from musegadget.service import DEFAULT_NOISE_HOST
from musegadget.voice_call import FRAME_BYTES, SAMPLE_RATE, VoiceCall
import musegadget.voice_call as vc

record_secs = float(os.environ.get("RECORD_SECS", "14"))
work_dir = os.environ.get("WORK_DIR", "/tmp/muse-voice")
in_wav_path = os.environ.get("IN_WAV", "/tmp/muse-voice/question.wav")
out_wav_path = os.environ.get("OUT_WAV", "/tmp/muse-voice/reply.wav")
force_record = os.environ.get("FORCE_RECORD", "1") != "0"
custom_thread_id = os.environ.get("CUSTOM_THREAD_ID", "").strip() or None


def write_file(path: str, text: str) -> None:
    try:
        with open(path, "w") as f:
            f.write(text.strip() + "\n")
    except Exception:
        pass


def save_wav(path: str, pcm_bytes: bytes) -> None:
    if not pcm_bytes:
        return
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with wave.open(path, "wb") as wf:
            wf.setnchannels(1)
            wf.setsampwidth(2)
            wf.setframerate(SAMPLE_RATE)
            wf.writeframes(pcm_bytes)
    except Exception:
        pass


class GlassRealtimeAudio:
    """Bridges `glass-wav stream-mic` and `glass-wav stream-play` to `VoiceCall`."""

    def __init__(self) -> None:
        self.mic_proc: subprocess.Popen | None = None
        self.play_proc: subprocess.Popen | None = None
        self.question_pcm = bytearray()
        self.reply_pcm = bytearray()
        self.speaking_started = False
        self.mic_stopped = False

    def start_mic(self) -> None:
        if self.mic_proc is not None:
            return
        subprocess.run(["/usr/bin/glass-wav", "chime", "start"], capture_output=True)
        write_file("/run/glass/nova-state", "LISTENING (TAP=SEND)")
        write_file("/run/glass/nova-user", "[SPEAK NOW — LIVE CALL]")
        self.mic_proc = subprocess.Popen(
            ["/usr/bin/glass-wav", "stream-mic", str(record_secs)],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            bufsize=0,
        )

    def stop_mic(self) -> None:
        if self.mic_stopped:
            return
        self.mic_stopped = True
        try:
            open("/run/glass/stop-record", "w").close()
        except Exception:
            pass
        if self.mic_proc is not None and self.mic_proc.poll() is None:
            try:
                self.mic_proc.terminate()
            except Exception:
                pass

    async def frames(self):
        if not force_record and os.path.isfile(in_wav_path) and os.path.getsize(in_wav_path) > 100:
            write_file("/run/glass/nova-state", "LISTENING (WAV)")
            with wave.open(in_wav_path, "rb") as wf:
                while True:
                    data = wf.readframes(FRAME_BYTES // 2)
                    if not data:
                        return
                    self.question_pcm.extend(data)
                    yield data
            return

        self.start_mic()
        assert self.mic_proc is not None and self.mic_proc.stdout is not None
        stdout = self.mic_proc.stdout
        while not self.mic_stopped:
            if os.path.exists("/run/glass/stop-call"):
                return
            chunk = await asyncio.to_thread(stdout.read, FRAME_BYTES)
            if not chunk:
                break
            if len(chunk) % 2 == 1:
                chunk = chunk[:-1]
            if not chunk:
                break
            self.question_pcm.extend(chunk)
            yield chunk

    def write(self, pcm: bytes) -> None:
        if not pcm or os.path.exists("/run/glass/stop-call"):
            return
        if not self.speaking_started:
            self.speaking_started = True
            self.stop_mic()
            write_file("/run/glass/nova-state", "SPEAKING")
            write_file("/run/glass/voice-state", "SPEAKING")
        if self.play_proc is None or self.play_proc.poll() is not None:
            self.play_proc = subprocess.Popen(
                ["/usr/bin/glass-wav", "stream-play"],
                stdin=subprocess.PIPE,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                bufsize=0,
            )
        self.reply_pcm.extend(pcm)
        try:
            if self.play_proc.stdin:
                self.play_proc.stdin.write(pcm)
                self.play_proc.stdin.flush()
        except Exception:
            pass

    def flush(self) -> None:
        pass

    def close(self) -> None:
        self.stop_mic()
        if self.mic_proc is not None:
            try:
                self.mic_proc.wait(timeout=1.0)
            except Exception:
                try:
                    self.mic_proc.kill()
                except Exception:
                    pass
        if self.play_proc is not None:
            try:
                if self.play_proc.stdin:
                    self.play_proc.stdin.close()
            except Exception:
                pass
            try:
                self.play_proc.wait(timeout=6.0)
            except Exception:
                try:
                    self.play_proc.kill()
                except Exception:
                    pass


async def main() -> int:
    pairing = config.load_json(config.PAIRING_FILE)
    if not pairing or not pairing.get("access_token"):
        write_file("/run/glass/nova-state", "NOT PAIRED")
        write_file("/run/glass/nova-reply", "MUSE NOT PAIRED — RUN MUSEGADGET PAIR.")
        return 1

    ident = identity.load_or_create()
    api = muse_api.api_root(pairing.get("api_url_v2", ""))
    try:
        vms, status = await asyncio.to_thread(
            muse_api.fetch_vms_with_status, pairing["access_token"], api
        )
    except Exception as exc:
        write_file("/run/glass/nova-state", "WIFI OFFLINE")
        write_file("/run/glass/nova-reply", f"NETWORK ERROR: {exc}")
        return 1

    if status != 200 or not vms:
        write_file("/run/glass/nova-state", "WIFI OFFLINE")
        write_file("/run/glass/nova-reply", f"MUSE API STATUS {status} — CHECK CONNECTION.")
        return 1

    vm = next((v for v in vms if v.get("is_default")), vms[0])
    vm_id = str(vm.get("vm_id") or vm.get("vm_name") or "")

    session = LinkSession(
        noise_host=pairing.get("noise_host") or DEFAULT_NOISE_HOST,
        vm_id=vm_id,
        vm_auth_token=vm["vm_auth_token"],
        app_id="hatch-web",
        register_device=False,
        device=DeviceDescription(ident.node_id, "Muse voice", __version__, {}),
        run_command=lambda *u: {"ok": False, "error": "unsupported command"},
    )

    audio = GlassRealtimeAudio()
    call_ref: list[VoiceCall] = []
    user_live = ""
    reply_live = ""

    orig_read_ndjson = vc.read_ndjson

    async def live_read_ndjson(stream):
        nonlocal user_live, reply_live
        async for ev in orig_read_ndjson(stream):
            if os.path.exists("/run/glass/stop-call"):
                if call_ref:
                    call_ref[0].reason = "user_hangup"
                return
            kind = ev.get("type", "")
            if kind == "hatch.voice.session":
                real_tid = ev.get("thread_id") or ""
                if vm_id and real_tid:
                    for p in ("/run/glass/voice.env", "/var/lib/musegadget/voice.env"):
                        try:
                            with open(p, "w") as f:
                                f.write(f'VM_ID="{vm_id}"\nTHREAD_ID="{real_tid}"\n')
                        except Exception:
                            pass
            elif kind == "input_audio_buffer.speech_started":
                write_file("/run/glass/nova-state", "LISTENING (SPEAKING)")
            elif kind == "conversation.item.input_audio_transcription.delta":
                delta = ev.get("delta") or ""
                if isinstance(delta, str) and delta:
                    user_live += delta
                    write_file("/run/glass/nova-user", user_live.strip())
            elif kind == "conversation.item.input_audio_transcription.completed":
                tr = (ev.get("transcript") or "").strip()
                if tr:
                    user_live = tr
                    write_file("/run/glass/nova-user", user_live)
                    print(f"You: {user_live}", flush=True)
            elif kind == "input_audio_buffer.speech_stopped":
                audio.stop_mic()
                write_file("/run/glass/nova-rms", "0")
                write_file("/run/glass/nova-state", "THINKING...")
                if not user_live:
                    write_file("/run/glass/nova-user", "[TRANSCRIBING...]")
                subprocess.Popen(
                    ["/usr/bin/glass-wav", "chime", "think"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
            elif kind == "response.output_audio_transcript.delta":
                delta = ev.get("delta") or ""
                if isinstance(delta, str) and delta:
                    reply_live += delta
                    write_file("/run/glass/nova-reply", reply_live.strip())
            elif kind == "response.output_audio_transcript.done":
                tr = (ev.get("transcript") or "").strip()
                if tr:
                    reply_live = tr
                    write_file("/run/glass/nova-reply", reply_live)
                    print(f"Muse: {reply_live}", flush=True)
            elif kind in ("response.done", "response.completed", "hatch.voice.turn_settled"):
                if call_ref and (audio.reply_pcm or reply_live):
                    call_ref[0]._active_turns.clear()
                    call_ref[0].idle_timeout = 0.6
            yield ev

    vc.read_ndjson = live_read_ndjson

    stop = asyncio.Event()
    conn_task = asyncio.create_task(session.run(stop))
    try:
        await session.wait_transport_ready(20)
        call = VoiceCall(
            session,
            device_id=ident.node_id,
            thread_id=custom_thread_id,
            half_duplex=True,
            idle_timeout=18,
            overall_timeout=90,
        )
        call_ref.append(call)
        await call.run(audio.frames(), audio, realtime_input=force_record)
    finally:
        audio.close()
        stop.set()
        try:
            await asyncio.wait_for(conn_task, 2.0)
        except Exception:
            conn_task.cancel()

    if audio.reply_pcm:
        save_wav(in_wav_path, bytes(audio.question_pcm))
        save_wav(out_wav_path, bytes(audio.reply_pcm))
        save_wav("/var/lib/musegadget/voice-reply-live.wav", bytes(audio.reply_pcm))
        turn_dir = f"/var/lib/musegadget/recordings/turn-{int(time.time())}"
        os.makedirs(turn_dir, exist_ok=True)
        save_wav(f"{turn_dir}/question.wav", bytes(audio.question_pcm))
        save_wav(f"{turn_dir}/reply.wav", bytes(audio.reply_pcm))
        try:
            with open(f"{turn_dir}/transcript.txt", "w") as tf:
                tf.write(f"YOU: {user_live}\nNOVA: {reply_live}\n")
            with open("/dev/fb0", "rb") as fb, open(f"{turn_dir}/prism.bgra", "wb") as pf:
                pf.write(fb.read(640 * 360 * 4))
        except Exception:
            pass
        write_file("/run/glass/nova-rms", "0")
        write_file("/run/glass/nova-state", "READY (TAP TO TALK)")
        write_file("/run/glass/voice-state", "IDLE")
        subprocess.run(["/usr/bin/glass-wav", "chime", "done"], capture_output=True)
        return 0
    else:
        write_file("/run/glass/nova-rms", "0")
        write_file("/run/glass/nova-state", "NO SPEECH HEARD (TAP)")
        write_file("/run/glass/voice-state", "IDLE")
        return 1


sys.exit(asyncio.run(main()))
PY
