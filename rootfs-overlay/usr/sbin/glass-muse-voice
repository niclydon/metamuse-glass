#!/bin/sh
# glass-muse-voice: Continuous Realtime Voice-Call Controller for Google Glass
# Explorer Edition (Vox / muse-gadget-overlay).
#
# Uses Meta Muse SDK's `VoiceCall` (`POST /voice/realtime` over Noise with
# `app_id="hatch-web"`, `server_vad`, 24 kHz mono PCM16LE, `half_duplex=True`)
# connected directly to:
#   - `glass-wav stream-mic 0`: continuous 48 kHz -> 24 kHz PCM16LE mic stream
#   - `conversation.item.input_audio_transcription.delta/.completed` -> live HUD user text
#   - `response.output_audio_transcript.delta/.done` -> live HUD streaming reply text
#   - `glass-wav stream-play`: continuous 24 kHz -> 48 kHz bone-conduction playback + 24-fps Chibi lip-sync
set -eu

mkdir -p /run/glass /tmp/muse-voice /var/lib/musegadget/recordings /var/lib/musegadget/logs

if [ "${1:-}" = "--tap" ]; then
    if [ -f /run/glass/voice-turn.lock ]; then
        old_pid="$(cat /run/glass/voice-turn.lock 2>/dev/null || true)"
        if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
            cur_state="$(cat /run/glass/nova-state 2>/dev/null || true)"
            case "$cur_state" in
                *"LISTENING (SPEAKING)"*)
                    # User tapped right after finishing a sentence -> force trailing silence so server_vad commits immediately
                    touch /run/glass/force-silence
                    exit 0
                    ;;
                *"CONNECTING"*|*"THINKING"*)
                    # Never abort an in-flight connection or pending Nova response on an accidental/late tap
                    exit 0
                    ;;
            esac
            touch /run/glass/stop-call /run/glass/stop-screen-rec /run/glass/stop-record
            for _ in 1 2 3 4 5 6; do
                kill -0 "$old_pid" 2>/dev/null || break
                usleep 250000 2>/dev/null || sleep 1
            done
            if kill -0 "$old_pid" 2>/dev/null; then
                kill -TERM "$old_pid" 2>/dev/null || true
            fi
            rm -f /run/glass/voice-turn.lock /run/glass/nova-speaking /run/glass/force-silence
            echo "0" > /run/glass/nova-rms
            echo "READY (TAP TO TALK)" > /run/glass/nova-state
            echo "IDLE" > /run/glass/voice-state
            exit 0
        fi
    fi
    shift
fi

rm -f /run/glass/stop-record /run/glass/stop-screen-rec /run/glass/stop-call /run/glass/force-silence /run/glass/nova-speaking
echo "$$" > /run/glass/voice-turn.lock
trap 'rm -f /run/glass/voice-turn.lock /run/glass/stop-record /run/glass/stop-screen-rec /run/glass/stop-call /run/glass/force-silence /run/glass/nova-speaking; echo "0" > /run/glass/nova-rms; echo "IDLE" > /run/glass/voice-state' EXIT INT TERM

# Ensure system clock is >= 2026 so TLS 1.3 certificate validation never fails on cold boot
if [ "$(date +%Y 2>/dev/null || echo 1970)" -lt 2026 ]; then
    hwclock -s -u 2>/dev/null || true
    if [ "$(date +%Y 2>/dev/null || echo 1970)" -lt 2026 ] && [ -s /var/lib/musegadget/last-clock ]; then
        date -u -s "$(cat /var/lib/musegadget/last-clock)" >/dev/null 2>&1 || true
    fi
    ntpd -n -q -p 162.159.200.1 -p 162.159.200.123 >/dev/null 2>&1 || true
    if [ "$(date +%Y 2>/dev/null || echo 1970)" -ge 2026 ]; then
        hwclock -w -u 2>/dev/null || true
        date -u +"%Y-%m-%d %H:%M:%S" > /var/lib/musegadget/last-clock 2>/dev/null || true
    fi
fi

/usr/sbin/glass-audio-route >/dev/null 2>&1 || true

RECORD_SECS="${RECORD_SECS:-35}"
WORK_DIR="${WORK_DIR:-/tmp/muse-voice}"
IN_WAV="$WORK_DIR/question.wav"
OUT_WAV="$WORK_DIR/reply.wav"

CUSTOM_THREAD_ID=""
for env_path in /var/lib/musegadget/voice.env /run/glass/voice.env /etc/muse-gadget/voice.env; do
    if [ -f "$env_path" ]; then
        # shellcheck disable=SC1090
        . "$env_path" || true
        if [ -n "${THREAD_ID:-}" ] && [ "${THREAD_ID:-}" != "e94d2f25-feda-483f-828e-72112aa020db" ]; then
            CUSTOM_THREAD_ID="${THREAD_ID}"
            break
        fi
    fi
done

echo "CONNECTING..." > /run/glass/nova-state
echo "[CONNECTING LIVE CALL...]" > /run/glass/nova-user
echo "[WAITING FOR YOUR VOICE...]" > /run/glass/nova-reply

export RECORD_SECS WORK_DIR IN_WAV OUT_WAV CUSTOM_THREAD_ID

python3 - <<'PY'
import asyncio
from datetime import datetime
import os
import queue
import subprocess
import sys
import threading
import time
import wave

from musegadget import __version__, config, identity, muse_api
from musegadget.link_client import DeviceDescription, LinkSession
from musegadget.service import DEFAULT_NOISE_HOST
from musegadget.voice_call import FRAME_BYTES, SAMPLE_RATE, VoiceCall
import musegadget.voice_call as vc

# Allow up to 120s (5.76 MB) of buffered TTS audio so fast-streaming long replies never raise "voice playback buffer full"
vc.MAX_PLAYBACK_BYTES = SAMPLE_RATE * 2 * 120

idle_secs = float(os.environ.get("RECORD_SECS", "35"))
work_dir = os.environ.get("WORK_DIR", "/tmp/muse-voice")
in_wav_path = os.environ.get("IN_WAV", "/tmp/muse-voice/question.wav")
out_wav_path = os.environ.get("OUT_WAV", "/tmp/muse-voice/reply.wav")
force_record = os.environ.get("FORCE_RECORD", "1") != "0"
proactive_greeting = os.environ.get("PROACTIVE_GREETING", "1") != "0" and force_record
custom_thread_id = os.environ.get("CUSTOM_THREAD_ID", "").strip() or None
LOG_FILE = "/var/lib/musegadget/logs/voice.log"


def log_msg(msg: str) -> None:
    ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
    line = f"[{ts}] {msg}"
    print(line, flush=True)
    try:
        with open(LOG_FILE, "a") as lf:
            lf.write(line + "\n")
    except Exception:
        pass


def write_file(path: str, text: str) -> None:
    try:
        with open(path, "w") as f:
            f.write(text.strip() + "\n")
    except Exception:
        pass


def save_wav(path: str, pcm_bytes: bytes) -> None:
    if not pcm_bytes:
        return
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with wave.open(path, "wb") as wf:
            wf.setnchannels(1)
            wf.setsampwidth(2)
            wf.setframerate(SAMPLE_RATE)
            wf.writeframes(pcm_bytes)
    except Exception:
        pass


class GlassRealtimeAudio:
    """Continuous 40ms frame bridge between `glass-wav` and `VoiceCall` + synchronized screen/audio recorder."""

    def __init__(self) -> None:
        self.mic_proc: subprocess.Popen | None = None
        self.play_proc: subprocess.Popen | None = None
        self.screen_rec_proc: subprocess.Popen | None = None
        self._capture: queue.Queue[bytes] = queue.Queue(maxsize=8)
        self._reader_thread: threading.Thread | None = None
        self.question_pcm = bytearray()
        self.reply_pcm = bytearray()
        self.turn_question_pcm = bytearray()
        self.turn_reply_pcm = bytearray()
        self.timeline_pcm = bytearray()
        self.play_write_cursor_bytes = 0
        self._timeline_lock = threading.Lock()
        self.t0 = time.monotonic()
        self.call_ready = False
        self.speaking_started = False
        self.awaiting_greeting = proactive_greeting
        self.greeting_deadline = 0.0
        self.closed = False

    def start_screen_recorder(self) -> None:
        if self.screen_rec_proc is not None:
            return
        try:
            if os.path.exists("/run/glass/stop-screen-rec"):
                os.unlink("/run/glass/stop-screen-rec")
        except Exception:
            pass
        self.t0 = time.monotonic()
        self.screen_rec_proc = subprocess.Popen(
            ["/usr/bin/glass-wav", "record-screen", f"{work_dir}/call-screen.gfbr", "12"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        log_msg(f"started local RLE screen recorder -> {work_dir}/call-screen.gfbr (12 fps)")

    def _append_timeline_mic(self, chunk: bytes) -> None:
        with self._timeline_lock:
            now_bytes = max(0, (int((time.monotonic() - self.t0) * SAMPLE_RATE) * 2) - len(chunk))
            if now_bytes >= self.play_write_cursor_bytes:
                if len(self.timeline_pcm) < now_bytes:
                    self.timeline_pcm.extend(b"\0" * (now_bytes - len(self.timeline_pcm)))
                self.timeline_pcm.extend(chunk)

    def _append_timeline_play(self, pcm: bytes) -> None:
        with self._timeline_lock:
            now_bytes = max(0, int((time.monotonic() - self.t0) * SAMPLE_RATE) * 2)
            if self.play_write_cursor_bytes < now_bytes:
                self.play_write_cursor_bytes = now_bytes
            if len(self.timeline_pcm) < self.play_write_cursor_bytes:
                self.timeline_pcm.extend(b"\0" * (self.play_write_cursor_bytes - len(self.timeline_pcm)))
            end_bytes = self.play_write_cursor_bytes + len(pcm)
            if len(self.timeline_pcm) < end_bytes:
                self.timeline_pcm.extend(b"\0" * (end_bytes - len(self.timeline_pcm)))
            self.timeline_pcm[self.play_write_cursor_bytes:end_bytes] = pcm
            self.play_write_cursor_bytes = end_bytes

    def _clear_capture(self) -> None:
        while True:
            try:
                self._capture.get_nowait()
            except queue.Empty:
                return

    def ensure_play_proc(self) -> None:
        if self.play_proc is None or self.play_proc.poll() is not None:
            self.play_proc = subprocess.Popen(
                ["/usr/bin/glass-wav", "stream-play"],
                stdin=subprocess.PIPE,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                bufsize=0,
            )

    def start_live_streams(self) -> None:
        if self.mic_proc is not None:
            return
        self.ensure_play_proc()
        if not self.speaking_started and not proactive_greeting:
            write_file("/run/glass/nova-state", "LIVE CALL (SPEAK NOW)")
            write_file("/run/glass/nova-user", "[SPEAK NOW — LIVE CALL]")
        self.mic_proc = subprocess.Popen(
            ["/usr/bin/glass-wav", "stream-mic", "0"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            bufsize=0,
        )
        self._reader_thread = threading.Thread(target=self._mic_reader_loop, daemon=True)
        self._reader_thread.start()
        log_msg("started continuous glass-wav stream-mic and stream-play")

    def _mic_reader_loop(self) -> None:
        assert self.mic_proc is not None and self.mic_proc.stdout is not None
        stdout = self.mic_proc.stdout
        while not self.closed:
            chunk = stdout.read(FRAME_BYTES)
            if not chunk:
                break
            if len(chunk) % 2 == 1:
                chunk = chunk[:-1]
            if not chunk:
                continue
            if self.call_ready and not self.awaiting_greeting and not self.speaking_started and not os.path.exists("/run/glass/nova-speaking"):
                self._append_timeline_mic(chunk)
            try:
                self._capture.put_nowait(chunk)
            except queue.Full:
                try:
                    self._capture.get_nowait()
                except queue.Empty:
                    pass
                try:
                    self._capture.put_nowait(chunk)
                except queue.Full:
                    pass

    async def frames(self):
        if not force_record and os.path.isfile(in_wav_path) and os.path.getsize(in_wav_path) > 100:
            self.ensure_play_proc()
            write_file("/run/glass/nova-state", "LISTENING (WAV)")
            log_msg(f"streaming synthetic input WAV: {in_wav_path}")
            with wave.open(in_wav_path, "rb") as wf:
                while not self.closed and not os.path.exists("/run/glass/stop-call"):
                    data = wf.readframes(FRAME_BYTES // 2)
                    if not data:
                        return
                    self.question_pcm.extend(data)
                    self.turn_question_pcm.extend(data)
                    self._append_timeline_mic(data)
                    yield data
            return

        self.start_live_streams()
        self._clear_capture()
        force_silence_frames = 0
        while not self.closed and not os.path.exists("/run/glass/stop-call"):
            if self.awaiting_greeting:
                now = time.monotonic()
                if self.greeting_deadline > 0 and now >= self.greeting_deadline:
                    self.awaiting_greeting = False
                    self._clear_capture()
                    if not self.speaking_started:
                        write_file("/run/glass/nova-state", "LIVE CALL (SPEAK NOW)")
                        write_file("/run/glass/nova-user", "[SPEAK NOW — LIVE CALL]")
                else:
                    self._clear_capture()
                    yield b"\0" * FRAME_BYTES
                    await asyncio.sleep(0.03)
                    continue
            if os.path.exists("/run/glass/force-silence"):
                try:
                    os.unlink("/run/glass/force-silence")
                except Exception:
                    pass
                force_silence_frames = 20  # 0.8s of silence to commit server_vad immediately
                log_msg("user tapped during speech -> injecting 0.8s silence for server_vad commit")
            if force_silence_frames > 0:
                force_silence_frames -= 1
                self._clear_capture()
                yield b"\0" * FRAME_BYTES
                await asyncio.sleep(0.02)
                continue
            try:
                chunk = self._capture.get_nowait()
                self.question_pcm.extend(chunk)
                self.turn_question_pcm.extend(chunk)
                yield chunk
            except queue.Empty:
                await asyncio.sleep(0.01)

    def write(self, pcm: bytes) -> None:
        if not pcm or self.closed or os.path.exists("/run/glass/stop-call"):
            return
        if not self.speaking_started:
            if vc.pcm_rms(pcm) < 300:
                # Ignore silent keepalive frames between turns so HUD never flips back to SPEAKING
                return
            self.speaking_started = True
            write_file("/run/glass/nova-state", "SPEAKING")
            write_file("/run/glass/voice-state", "SPEAKING")
            log_msg("Nova audio playback started")
        self.ensure_play_proc()
        self.reply_pcm.extend(pcm)
        self.turn_reply_pcm.extend(pcm)
        self._append_timeline_play(pcm)
        try:
            if self.play_proc and self.play_proc.stdin:
                self.play_proc.stdin.write(pcm)
                self.play_proc.stdin.flush()
        except Exception as exc:
            log_msg(f"stream-play write error: {exc}")

    def flush(self) -> None:
        pass

    def close(self) -> None:
        if self.closed:
            return
        self.closed = True
        try:
            open("/run/glass/stop-record", "w").close()
            open("/run/glass/stop-screen-rec", "w").close()
        except Exception:
            pass
        if self.mic_proc is not None:
            try:
                self.mic_proc.terminate()
                self.mic_proc.wait(timeout=1.0)
            except Exception:
                try:
                    self.mic_proc.kill()
                except Exception:
                    pass
        if self.play_proc is not None:
            try:
                if self.play_proc.stdin:
                    self.play_proc.stdin.close()
            except Exception:
                pass
            try:
                self.play_proc.wait(timeout=3.0)
            except Exception:
                try:
                    self.play_proc.kill()
                except Exception:
                    pass
        if self.screen_rec_proc is not None:
            try:
                self.screen_rec_proc.wait(timeout=1.5)
            except Exception:
                try:
                    self.screen_rec_proc.terminate()
                    self.screen_rec_proc.wait(timeout=0.5)
                except Exception:
                    pass
        with self._timeline_lock:
            end_bytes = max(0, int((time.monotonic() - self.t0) * SAMPLE_RATE) * 2)
            if len(self.timeline_pcm) < end_bytes:
                self.timeline_pcm.extend(b"\0" * (end_bytes - len(self.timeline_pcm)))
            tl_bytes = bytes(self.timeline_pcm)
        if tl_bytes:
            tl_path = f"{work_dir}/call-timeline.wav"
            save_wav(tl_path, tl_bytes)
            save_wav("/var/lib/musegadget/recordings/latest-call-audio.wav", tl_bytes)
            try:
                import shutil
                gfbr_src = f"{work_dir}/call-screen.gfbr"
                if os.path.isfile(gfbr_src):
                    shutil.copyfile(gfbr_src, "/var/lib/musegadget/recordings/latest-call-screen.gfbr")
            except Exception as exc:
                log_msg(f"copy latest-call-screen.gfbr error: {exc}")
            log_msg(f"saved synchronized call timeline ({len(tl_bytes) / (SAMPLE_RATE * 2):.1f}s) + RLE screen recording")


async def main() -> int:
    global custom_thread_id
    log_msg(f"=== glass-muse-voice starting (proactive_greeting={proactive_greeting}) ===")
    audio = GlassRealtimeAudio()
    audio.start_screen_recorder()
    if force_record:
        subprocess.run(["/usr/bin/glass-wav", "chime", "start"], capture_output=True)
    pairing = config.load_json(config.PAIRING_FILE)
    if not pairing or not pairing.get("access_token"):
        write_file("/run/glass/nova-state", "NOT PAIRED")
        write_file("/run/glass/nova-reply", "MUSE NOT PAIRED — RUN MUSEGADGET PAIR.")
        log_msg("error: not paired")
        audio.close()
        return 1

    ident = identity.load_or_create()
    api = muse_api.api_root(pairing.get("api_url_v2", ""))
    try:
        vms, status = await asyncio.to_thread(
            muse_api.fetch_vms_with_status, pairing["access_token"], api
        )
    except Exception as exc:
        write_file("/run/glass/nova-state", "WIFI OFFLINE")
        write_file("/run/glass/nova-reply", f"NETWORK ERROR: {exc}")
        log_msg(f"fetch_vms error: {exc}")
        audio.close()
        return 1

    if status != 200 or not vms:
        write_file("/run/glass/nova-state", "WIFI OFFLINE")
        write_file("/run/glass/nova-reply", f"MUSE API STATUS {status} — CHECK CONNECTION.")
        log_msg(f"fetch_vms status={status}")
        audio.close()
        return 1

    vm = next((v for v in vms if v.get("is_default")), vms[0])
    vm_id = str(vm.get("vm_id") or vm.get("vm_name") or "")

    session = LinkSession(
        noise_host=pairing.get("noise_host") or DEFAULT_NOISE_HOST,
        vm_id=vm_id,
        vm_auth_token=vm["vm_auth_token"],
        app_id="hatch-web",
        register_device=False,
        device=DeviceDescription(ident.node_id, "Muse voice", __version__, {}),
        run_command=lambda *u: {"ok": False, "error": "unsupported command"},
    )

    call_ref: list[VoiceCall] = []
    user_live = ""
    reply_live = ""
    turn_response_done = False
    turn_response_done_ts = 0.0
    turns_completed = 0

    def save_turn_artifacts() -> None:
        nonlocal turns_completed
        if not audio.turn_reply_pcm and not reply_live:
            return
        turns_completed += 1
        q_bytes = bytes(audio.turn_question_pcm or audio.question_pcm)
        r_bytes = bytes(audio.turn_reply_pcm or audio.reply_pcm)
        save_wav(in_wav_path, q_bytes)
        if r_bytes:
            save_wav(out_wav_path, r_bytes)
            save_wav("/var/lib/musegadget/voice-reply-live.wav", r_bytes)
        turn_dir = f"/var/lib/musegadget/recordings/turn-{int(time.time())}"
        os.makedirs(turn_dir, exist_ok=True)
        save_wav(f"{turn_dir}/question.wav", q_bytes)
        if r_bytes:
            save_wav(f"{turn_dir}/reply.wav", r_bytes)
        try:
            with open(f"{turn_dir}/transcript.txt", "w") as tf:
                tf.write(f"YOU: {user_live}\nNOVA: {reply_live}\n")
            with open("/dev/fb0", "rb") as fb, open(f"{turn_dir}/prism.bgra", "wb") as pf:
                pf.write(fb.read(640 * 360 * 4))
        except Exception:
            pass
        log_msg(f"saved turn #{turns_completed} artifacts to {turn_dir} (reply_pcm={len(r_bytes)} bytes)")

    orig_read_ndjson = vc.read_ndjson
    last_reply_write_ts = 0.0

    async def live_read_ndjson(stream):
        nonlocal user_live, reply_live, turn_response_done, turn_response_done_ts, last_reply_write_ts
        async for ev in orig_read_ndjson(stream):
            if os.path.exists("/run/glass/stop-call"):
                if call_ref:
                    call_ref[0].reason = "user_hangup"
                return
            kind = ev.get("type", "")
            if kind == "hatch.voice.session":
                real_tid = ev.get("thread_id") or ""
                audio.call_ready = True
                log_msg(f"voice session established: call_id={ev.get('call_id')} thread_id={real_tid}")
                if proactive_greeting and not audio.speaking_started:
                    audio.awaiting_greeting = True
                    audio.greeting_deadline = time.monotonic() + 4.5
                    write_file("/run/glass/nova-state", "THINKING...")
                    write_file("/run/glass/nova-user", "[CALL CONNECTED — NOVA GREETING]")
                if vm_id and real_tid:
                    for p in ("/run/glass/voice.env", "/var/lib/musegadget/voice.env"):
                        try:
                            with open(p, "w") as f:
                                f.write(f'VM_ID="{vm_id}"\nTHREAD_ID="{real_tid}"\n')
                        except Exception:
                            pass
            elif kind == "input_audio_buffer.speech_started":
                log_msg("VAD: speech_started")
                user_live = ""
                reply_live = ""
                turn_response_done = False
                audio.speaking_started = False
                audio.turn_question_pcm.clear()
                audio.turn_reply_pcm.clear()
                write_file("/run/glass/nova-state", "LISTENING (SPEAKING)")
                write_file("/run/glass/nova-user", "[LISTENING...]")
            elif kind == "conversation.item.input_audio_transcription.delta":
                delta = ev.get("delta") or ""
                if isinstance(delta, str) and delta:
                    user_live += delta
                    write_file("/run/glass/nova-user", user_live.strip())
            elif kind == "conversation.item.input_audio_transcription.completed":
                tr = (ev.get("transcript") or "").strip()
                if tr:
                    user_live = tr
                    write_file("/run/glass/nova-user", user_live)
                    log_msg(f"You: {user_live}")
            elif kind == "input_audio_buffer.speech_stopped":
                log_msg("VAD: speech_stopped")
                write_file("/run/glass/nova-rms", "0")
                write_file("/run/glass/nova-state", "THINKING...")
                if not user_live:
                    write_file("/run/glass/nova-user", "[TRANSCRIBING...]")
            elif kind == "response.output_audio_transcript.delta":
                delta = ev.get("delta") or ""
                if isinstance(delta, str) and delta:
                    reply_live += delta
                    now_ts = time.monotonic()
                    if now_ts - last_reply_write_ts >= 0.12:
                        last_reply_write_ts = now_ts
                        write_file("/run/glass/nova-reply", reply_live.strip())
            elif kind == "response.output_audio_transcript.done":
                tr = (ev.get("transcript") or "").strip()
                if tr:
                    reply_live = tr
                    write_file("/run/glass/nova-reply", reply_live)
                    log_msg(f"Muse: {reply_live}")
            elif kind in ("response.done", "response.completed", "hatch.voice.turn_settled"):
                log_msg(f"event: {kind}")
                if audio.turn_reply_pcm or reply_live:
                    turn_response_done = True
                    turn_response_done_ts = time.monotonic()
                elif audio.awaiting_greeting and not audio.speaking_started:
                    audio.awaiting_greeting = False
                    audio._clear_capture()
                    write_file("/run/glass/nova-state", "LIVE CALL (SPEAK NOW)")
                    write_file("/run/glass/nova-user", "[SPEAK NOW — LIVE CALL]")
                    log_msg("proactive greeting skipped by server -> mic open immediately")
            yield ev

    vc.read_ndjson = live_read_ndjson

    stop = asyncio.Event()
    conn_task = asyncio.create_task(session.run(stop))
    call_task: asyncio.Task | None = None

    async def watch_call_state() -> None:
        nonlocal turn_response_done
        while True:
            await asyncio.sleep(0.1)
            if os.path.exists("/run/glass/stop-call"):
                log_msg("stop-call detected -> ending call")
                if call_ref:
                    call_ref[0].reason = "user_hangup"
                if call_task and not call_task.done():
                    call_task.cancel()
                return
            if turn_response_done and call_ref:
                c = call_ref[0]
                now = time.monotonic()
                still_playing = (
                    (c._audible_frames > 0)
                    or (now < c._playing_until)
                    or os.path.exists("/run/glass/nova-speaking")
                    or (now - turn_response_done_ts < 0.35)
                )
                if not still_playing:
                    turn_response_done = False
                    audio.speaking_started = False
                    audio.awaiting_greeting = False
                    c._received_audio = False
                    audio._clear_capture()
                    save_turn_artifacts()
                    if not force_record:
                        log_msg("synthetic WAV turn playback finished -> ending call")
                        c.reason = "wav_turn_complete"
                        if call_task and not call_task.done():
                            call_task.cancel()
                        return
                    # Re-arm idle window and return HUD to LIVE CALL listening state for next turn!
                    c._activity = time.monotonic()
                    write_file("/run/glass/nova-rms", "0")
                    write_file("/run/glass/nova-state", "LIVE CALL (SPEAK / TAP=END)")
                    write_file("/run/glass/voice-state", "IDLE")
                    log_msg("turn playback finished -> listening for follow-up turn")

    watcher_task = asyncio.create_task(watch_call_state())
    try:
        await session.wait_transport_ready(20)
        seed_marker = "/var/lib/musegadget/glass-thread-seeded"
        seeded_tid = ""
        try:
            if os.path.isfile(seed_marker):
                seeded_tid = open(seed_marker).read().strip()
        except Exception:
            pass
        if not custom_thread_id or seeded_tid != custom_thread_id:
            try:
                from musegadget.link_client import acknowledgement
                brief_req = {
                    "message": (
                        "[Google Glass Explorer Edition Wearable Context] "
                        "Nic is connected from his Google Glass Explorer Edition wearable "
                        "(running dual-boot NexusOS Prism + GlassOS Vox on the 640x360 prism HUD, "
                        "bone-conduction audio, and 5MP OV5680 camera). "
                        "Both live voice calls and camera snaps on the glasses share this dedicated thread. "
                        "When greeting or replying on a call, keep responses natural, concise, and wearable-friendly."
                    ),
                    "device_id": ident.node_id,
                }
                if custom_thread_id:
                    brief_req["session_id"] = custom_thread_id
                res = await asyncio.wait_for(session._post_chat(brief_req), 6.0)
                ack = acknowledgement(res)
                if getattr(ack, "session_id", None):
                    custom_thread_id = ack.session_id
                if custom_thread_id:
                    write_file(seed_marker, custom_thread_id)
                    for p in ("/run/glass/voice.env", "/var/lib/musegadget/voice.env"):
                        write_file(p, f'VM_ID="{vm_id}"\nTHREAD_ID="{custom_thread_id}"\n')
                    log_msg(f"seeded dedicated Google Glass thread brief: thread_id={custom_thread_id}")
            except Exception as e:
                log_msg(f"thread brief seed skipped: {e}")
        audio.ensure_play_proc()
        call = VoiceCall(
            session,
            device_id=ident.node_id,
            thread_id=custom_thread_id,
            half_duplex=True,
            idle_timeout=idle_secs,
            overall_timeout=360,
        )
        play_cursor = 0.0
        orig_flush = call._flush

        def _smooth_flush() -> None:
            nonlocal play_cursor
            play_cursor = 0.0
            orig_flush()

        async def _smooth_play() -> None:
            nonlocal play_cursor
            from musegadget.voice_call import SETTLE_SECONDS

            while True:
                if not call._playback:
                    await asyncio.sleep(0.015)
                    continue
                now = time.monotonic()
                if play_cursor - now > 0.80:
                    await asyncio.sleep(0.02)
                    continue
                batch = bytearray()
                any_audible = False
                while call._playback and (play_cursor - now <= 0.80):
                    pcm, audible = call._playback.popleft()
                    call._playback_bytes -= len(pcm)
                    call._audible_frames -= int(audible)
                    if not any(pcm):
                        if not audio.speaking_started or (turn_response_done and call._audible_frames == 0):
                            # Discard all-zero keepalive frames before speech starts or after speech completes
                            continue
                    batch.extend(pcm)
                    duration = len(pcm) / (SAMPLE_RATE * 2)
                    if play_cursor < now:
                        play_cursor = now
                    play_cursor += duration
                    if any(pcm):
                        call._playing_until = play_cursor + SETTLE_SECONDS
                    if audible:
                        any_audible = True
                        call._activity = now
                if batch:
                    call._output.write(bytes(batch))
                if any_audible:
                    audio.awaiting_greeting = False
                await asyncio.sleep(0.01)

        call._flush = _smooth_flush  # type: ignore[method-assign]
        call._play = _smooth_play  # type: ignore[method-assign]
        if proactive_greeting:
            orig_start = call._start

            async def _start_with_proactive_greeting() -> None:
                from urllib.parse import urlencode
                from musegadget.noise import Header
                from musegadget.voice_call import END_CALL_STOP_OFFER

                query = {"call_id": call.call_id}
                call._stream = await call.session.stream_request(
                    "POST",
                    "/voice/realtime?" + urlencode(query),
                    headers=[Header("Content-Type", "application/x-ndjson; charset=utf-8")],
                )
                start = {
                    "type": "hatch.voice.call.start",
                    "call_id": call.call_id,
                    "device": "mcu-wearable",
                    "device_id": call.device_id,
                    "call_media_type": "audio",
                    "proactive_greeting_enabled": True,
                }
                if call.thread_id:
                    start["thread_id"] = call.thread_id
                call._admission_sent = True
                await call._event(start)
                await call._event(END_CALL_STOP_OFFER)
                await call._stream.wait_response()

            call._start = _start_with_proactive_greeting  # type: ignore[method-assign]
        call_ref.append(call)
        call_task = asyncio.create_task(
            call.run(audio.frames(), audio, realtime_input=force_record)
        )
        reason = await call_task
        log_msg(f"call.run finished with reason={reason}")
    except asyncio.CancelledError:
        log_msg(f"call_task cancelled (reason={call_ref[0].reason if call_ref else 'cancelled'})")
    except Exception as exc:
        log_msg(f"call.run exception ({type(exc).__name__}): {exc}")
    finally:
        watcher_task.cancel()
        if turn_response_done or (audio.turn_reply_pcm and turns_completed == 0):
            save_turn_artifacts()
        audio.close()
        stop.set()
        try:
            await asyncio.wait_for(conn_task, 2.0)
        except Exception:
            conn_task.cancel()

    write_file("/run/glass/nova-rms", "0")
    write_file("/run/glass/voice-state", "IDLE")
    subprocess.run(["/usr/bin/glass-wav", "chime", "done"], capture_output=True)
    if turns_completed > 0 or audio.reply_pcm:
        write_file("/run/glass/nova-state", "READY (TAP TO TALK)")
        log_msg(f"=== glass-muse-voice finished cleanly ({turns_completed} turns) ===")
        return 0
    else:
        write_file("/run/glass/nova-state", "READY (TAP TO TALK)")
        log_msg("=== glass-muse-voice finished (no turns spoken) ===")
        return 0


sys.exit(asyncio.run(main()))
PY
