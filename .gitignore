# Build outputs, caches, and device state are never committed.
out/
work/
*.img
*.bin
*.xz
*.apk
*.tar.gz

# Credentials and pairing state are supplied at run time, never stored here.
*wpa_supplicant.conf
*pairing*.json
*sdk_token*
.env

# Raw test captures and screen recordings belong only in the private glass-os repo
docs/screenshots/live-capture-*
docs/screenshots/prism-clip-*
docs/screenshots/camera-clip-*
